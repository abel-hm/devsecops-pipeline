{
  "name": "devsecops-pipeline",
  "version": "1.0.0",
  "private": true,
  "description": "A small Express API used to demonstrate a gated GitHub Actions CI/CD pipeline.",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "lint": "eslint src test scripts --max-warnings=0",
    "build": "node scripts/build.js",
    "security:sast": "node scripts/security-scan.js"
  },
  "dependencies": {
    "express": "5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0"
  }
}
